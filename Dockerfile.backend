# Dockerfile.backend
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies needed for some libraries
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install (filtering out heavy local-only packages for cloud memory compliance)
COPY requirements.txt .
RUN python -c "f=open('requirements.txt'); lines=[l for l in f if 'sentence-transformers' not in l and 'langchain-huggingface' not in l]; f.close(); w=open('requirements_cloud.txt','w'); w.writelines(lines); w.close()" && \
    pip install --no-cache-dir -r requirements_cloud.txt

# Copy source code
COPY src/ ./src/
COPY api.py .
COPY main.py .

# Create volume directories for ChromaDB and SQLite DB
RUN mkdir -p /app/data

# Expose port
EXPOSE 8000

# Run FastAPI backend
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
